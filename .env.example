# ---------------------------------------------------------------------------
# CineVault environment template
#
# Copy to `.env.local` and fill in your own values. NEVER commit real keys.
#   cp .env.example .env.local
#
# NOTE: every VITE_* variable is inlined into the client bundle at build time
# and is therefore PUBLIC. Do not put anything secret behind a VITE_ prefix.
# ---------------------------------------------------------------------------

# TMDB API key. Free key from https://www.themoviedb.org/settings/api
# This is exposed to the browser. Restrict it in the TMDB dashboard, and move
# it behind a server-side proxy before going to production.
VITE_TMDB_API_KEY=

# Optional: point the client at a server-side TMDB proxy instead of calling
# api.themoviedb.org directly. When set, VITE_TMDB_API_KEY is not needed.
# VITE_TMDB_PROXY_URL=https://your-proxy.example.com/tmdb

# Firebase Web config (public by design -- access is controlled by
# firestore.rules, not by hiding these values).
# Firebase Console > Project Settings > General > Your apps > Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Personal "birthday" microsite. Leave false for any public deployment.
# This is a feature flag, not a security boundary -- the code it gates ships
# in the bundle regardless.
VITE_ENABLE_BIRTHDAY=false
