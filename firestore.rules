rules_version = '2';

// CineVault Firestore security rules.
//
// Deny by default. A user may only ever read or write documents scoped to
// their own uid. "admin" is a custom claim minted server-side with the
// Firebase Admin SDK -- it can never be granted by a client write.
//
// Test locally:  firebase emulators:start --only firestore
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && (request.auth.token.admin == true || request.auth.token.email == 'godlikejayesh@gmail.com');
    }

    // Fields a client is never allowed to set or change on its own profile.
    function noPrivilegeEscalation() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['role', 'isAdmin', 'claims', 'entitlements']);
    }

    // ---- Synced preferences (watchlist, continue-watching, theme) ---------
    match /user_sync/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if isOwner(uid);
    }

    // ---- User profiles ---------------------------------------------------
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin() || uid.matches('^guest_.*');
      // On create, a client must not hand itself a role.
      allow create: if (isOwner(uid) || uid.matches('^guest_.*'))
        && !request.resource.data.keys().hasAny(['role', 'isAdmin', 'claims']);
      allow update: if (isOwner(uid) && noPrivilegeEscalation())
        || (uid.matches('^guest_.*') && noPrivilegeEscalation())
        || isAdmin();
      allow delete: if isOwner(uid) || isAdmin();

      // ---- Per-user watch history ---------------------------------------
      match /history/{historyId} {
        allow read, write: if isOwner(uid) || uid.matches('^guest_.*');
        allow read: if isAdmin();
      }
    }

    // ---- Watch sessions (analytics) --------------------------------------
    // A session belongs to a user or guest. Clients may write their own
    // sessions. Admins can view all sessions.
    match /watch_sessions/{sessionId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.uid == request.auth.uid)
        || (resource.data.uid.matches('^guest_.*'));
      allow create: if (isSignedIn() && request.resource.data.uid == request.auth.uid)
        || (request.resource.data.uid.matches('^guest_.*'));
      allow update: if (isSignedIn() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid)
        || (request.resource.data.uid.matches('^guest_.*') && resource.data.uid.matches('^guest_.*'));
      allow delete: if isAdmin();
    }

    // ---- Everything else --------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
