rules_version = '2';

// CineVault Firestore security rules.
//
// Deny by default. A user may only ever read or write documents scoped to
// their own uid. "admin" is a custom claim minted server-side with the
// Firebase Admin SDK -- it can never be granted by a client write, and there
// is no email allowlist here (a hardcoded address used to sit in isAdmin(),
// which both leaked a personal email and contradicted the line above).
//
// Guests are Firebase *anonymous* sessions, so they have real uids and are
// covered by isOwner(). The previous rules allowed `uid.matches('^guest_.*')`,
// which let any unauthenticated visitor read and overwrite every guest profile
// and every guest watch-history document, and read all guest watch sessions.
//
// Test locally:  firebase emulators:start --only firestore
//                npm run test:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // Fields a client is never allowed to set or change on its own profile.
    function noPrivilegeEscalation() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['role', 'isAdmin', 'claims', 'entitlements']);
    }

    // ---- Synced preferences (watchlist, continue-watching, theme) ---------
    match /user_sync/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if isOwner(uid);
    }

    // ---- User profiles ---------------------------------------------------
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // On create, a client must not hand itself a role.
      allow create: if isOwner(uid)
        && !request.resource.data.keys().hasAny(['role', 'isAdmin', 'claims']);
      allow update: if (isOwner(uid) && noPrivilegeEscalation()) || isAdmin();
      allow delete: if isOwner(uid) || isAdmin();

      // ---- Per-user watch history ---------------------------------------
      match /history/{historyId} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if isOwner(uid);
      }
    }

    // ---- Watch sessions (analytics) --------------------------------------
    // A session belongs to exactly one uid. Clients may only ever read and
    // write their own; admins can read and delete all.
    match /watch_sessions/{sessionId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    // ---- Everything else --------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
